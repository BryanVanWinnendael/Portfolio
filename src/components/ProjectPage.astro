---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';

interface Item {
  text: string;
  href?: string;
}

interface Section {
  title: string;
  items: Item[];
}

interface ProjectImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  icon: string;
  sections: Section[];
  images?: ProjectImage[];
}

const { title, description, icon, sections, images = [] } = Astro.props;
const sectionId = (name: string) => name.toLowerCase().replace(/\s+/g, '-');
const slug = Astro.url.pathname.split('/').filter(Boolean).pop();
const widthsFor = (width: number) => [...[560, 1120].filter((candidate) => candidate < width), width];

const githubPath =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';
const isGithub = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, '').endsWith('github.com');
  } catch {
    return false;
  }
};
---

<Layout title={`${title} — Bryan Van Winnendael`} description={description}>
  <div class="project-page">
    <a class="project-back" href="/" data-back-to-projects>&larr; All projects</a>

    <header class="project-brand">
      <img
        class="project-icon"
        src={icon}
        alt=""
        width="44"
        height="44"
        decoding="async"
        transition:name={`project-icon-${slug}`}
      />
      <h1 class="project-title" transition:name={`project-title-${slug}`}>{title}</h1>
    </header>

    <main id="main" class="project-content" tabindex="-1">
      {images.length > 0 && (
        <section class="project-gallery" aria-label={`${title} screenshots`}>
          {images.map((image, index) => (
            <figure
              class:list={[
                'project-shot',
                { 'project-shot--portrait': image.src.height > image.src.width },
              ]}
            >
              <Image
                src={image.src}
                alt={image.alt}
                widths={widthsFor(image.src.width)}
                sizes="(max-width: 600px) calc(100vw - 40px), 560px"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          ))}
        </section>
      )}

      {sections.map((section) => (
        <section class="project-section">
          <h2 id={sectionId(section.title)} class="rule-label">
            {section.title}
          </h2>
          <ul class="project-list">
            {section.items.map((item) => (
              <li class:list={['project-item', { 'project-item--link': !!item.href }]}>
                {!item.href && <span class="point-dash" aria-hidden="true">&mdash;</span>}
                {item.href ? (
                  <a class="project-link" href={item.href} target="_blank" rel="noreferrer">
                    {isGithub(item.href) ? (
                      <svg class="project-link-icon project-link-icon--github" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d={githubPath}></path>
                      </svg>
                    ) : (
                      <svg
                        class="project-link-icon project-link-icon--globe"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M2 12h20"></path>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                      </svg>
                    )}
                    <span>{item.text}</span>
                  </a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>

    <footer class="colophon">
      <p class="fineprint">
        <span>© {new Date().getFullYear()} Bryan Van Winnendael</span>
        <span>·</span>
        <span><a href="/" data-back-to-projects>Back to all projects</a></span>
      </p>
    </footer>
  </div>
</Layout>

<script>
  type HistoryState = { index?: number } | null;

  const bindBackLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-back-to-projects]').forEach((link) => {
      if (link.dataset.backBound === 'true') return;
      link.dataset.backBound = 'true';

      link.addEventListener('click', (event) => {
        const state = history.state as HistoryState;
        if ((state?.index ?? 0) > 0) {
          event.preventDefault();
          history.back();
        }
      });
    });
  };

  const globalScope = window as Window & { __projectBackLinksBound?: boolean };
  if (!globalScope.__projectBackLinksBound) {
    globalScope.__projectBackLinksBound = true;
    document.addEventListener('astro:page-load', bindBackLinks);
  }
  bindBackLinks();
</script>

<style>
  @media (hover: hover) and (pointer: fine) {
    .project-back:hover,
    .project-link:hover {
      color: var(--ink);
      border-color: var(--accent-2);
      background: var(--surface-2);
    }
  }

  .project-back:active {
    color: var(--ink);
  }
</style>
